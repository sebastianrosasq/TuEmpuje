{
  "name": "tuempuje-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "android:config": "node configure-android.mjs",
    "emulators": "firebase emulators:start --project demo-tuempuje --only auth,firestore,functions",
    "test:rules": "firebase emulators:exec --project demo-tuempuje --only firestore \"node --test test/firestore.rules.test.mjs\"",
    "test:deletion": "firebase emulators:exec --project demo-tuempuje --only auth,firestore,functions \"node --test functions/delete-account.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
