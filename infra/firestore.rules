rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function active(uid) {
      return !exists(/databases/$(database)/documents/deletionJobs/$(uid));
    }

    function textWithin(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validIdentity(data) {
      return data.get('dni', '') is string && (
        (data.get('documentType', 'DNI') == 'DNI' && data.dni.matches('[0-9]{8}'))
        || (data.get('documentType', 'DNI') == 'CE' && data.dni.matches('[0-9]{1,11}'))
        || (data.get('documentType', 'DNI') == 'PASAPORTE' && data.dni.matches('[A-Z0-9]{1,15}'))
      );
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'email'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'dni', 'documentType', 'phone', 'nationality', 'skills', 'experience', 'availability', 'role', 'accountType', 'interests', 'district', 'organization', 'education', 'portfolio', 'businessType', 'businessSector', 'businessDescription'])
        && data.uid == uid
        && textWithin(data.displayName, 2, 80)
        && data.displayName.matches('(?s).*\\S.*')
        && textWithin(data.email, 3, 254)
        && (!('dni' in data) || validIdentity(data))
        && (!('phone' in data) || (data.phone is string && data.phone.matches('9[0-9]{8}')))
        && (!('nationality' in data) || textWithin(data.nationality, 2, 80))
        && (!('skills' in data) || textWithin(data.skills, 0, 500))
        && (!('experience' in data) || textWithin(data.experience, 0, 1500))
        && (!('availability' in data) || textWithin(data.availability, 0, 200))
        && (!('role' in data) || data.role in ['worker', 'employer'])
        && (!('accountType' in data) || (data.accountType in ['person', 'company']
          && ((data.accountType == 'person' && data.get('role', '') == 'worker' && data.get('businessType', '') != 'NEGOCIO')
            || (data.accountType == 'company' && data.get('role', '') == 'employer'
              && data.get('businessType', 'NEGOCIO') == 'NEGOCIO'
              && textWithin(data.get('organization', ''), 2, 100)))))
        && (!('interests' in data) || (data.interests is list && data.interests.size() <= 11 && data.interests.hasOnly(['Ayudantía', 'Creativo', 'Diseño y edición', 'Programación', 'Ventas y atención', 'Administración', 'Eventos', 'Logística', 'Educación', 'Servicios', 'Otro'])))
        && (!('district' in data) || textWithin(data.district, 0, 100))
        && (!('organization' in data) || textWithin(data.organization, 0, 100))
        && (!('businessType' in data) || data.businessType in ['PERSONA', 'PROFESIONAL', 'NEGOCIO'])
        && (!('businessType' in data) || data.businessType != 'NEGOCIO' || (textWithin(data.get('organization', ''), 2, 100) && data.organization.matches('(?s).*\\S.*')))
        && (!('businessSector' in data) || textWithin(data.businessSector, 0, 80))
        && (!('businessDescription' in data) || textWithin(data.businessDescription, 0, 500))
        && (!('education' in data) || textWithin(data.education, 0, 500))
        && (!('portfolio' in data) || textWithin(data.portfolio, 0, 500));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && active(request.auth.uid)
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['dni', 'phone'])
        && validProfile(request.resource.data, uid)
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && active(request.auth.uid)
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && (!('accountType' in resource.data) || request.resource.data.get('accountType', '') == resource.data.accountType)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'dni', 'documentType', 'phone', 'nationality', 'skills', 'experience', 'availability', 'role', 'accountType', 'interests', 'district', 'organization', 'education', 'portfolio', 'businessType', 'businessSector', 'businessDescription']);
      allow delete: if false;
    }

    function opportunityPath(opportunityId) {
      return /databases/$(database)/documents/opportunities/$(opportunityId);
    }

    function validBusinessSnapshot(data) {
      let fields = ['publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription'];
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !data.keys().hasAny(fields) || (profile.get('accountType', '') == 'company' && data.keys().hasAll(fields)
        && textWithin(data.publicBusinessName, 2, 100)
        && data.publicBusinessName == profile.get('organization', '')
        && data.publicBusinessSector == profile.get('businessSector', '')
        && data.publicBusinessDescription == profile.get('businessDescription', ''));
    }

    function validOpportunity(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'description', 'location', 'pay', 'duration',
          'vacancies', 'status', 'createdAt', 'ownerName', 'category', 'requirements', 'selectedCount'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'description', 'location', 'pay', 'duration',
          'vacancies', 'status', 'createdAt', 'ownerName', 'category', 'requirements', 'selectedCount', 'noExperienceRequired', 'workMode',
          'publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription'
        ])
        && data.ownerId == request.auth.uid
        && data.ownerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && textWithin(data.ownerName, 2, 80)
        && textWithin(data.category, 2, 40)
        && textWithin(data.requirements, 2, 1500)
        && (!('noExperienceRequired' in data) || data.noExperienceRequired is bool)
        && (!('workMode' in data) || data.workMode in ['Presencial', 'Híbrido', 'Remoto'])
        && validBusinessSnapshot(data)
        && textWithin(data.title, 3, 120)
        && textWithin(data.description, 10, 3000)
        && textWithin(data.location, 2, 120)
        && textWithin(data.pay, 3, 120)
        && textWithin(data.duration, 2, 120)
        && data.vacancies is int && data.vacancies >= 1 && data.vacancies <= 1000
        && data.status == 'published'
        && data.selectedCount == 0
        && data.createdAt == request.time;
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn() && (resource.data.status == 'published'
        || resource.data.ownerId == request.auth.uid
        || exists(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.auth.uid)));
      allow create: if signedIn() && active(request.auth.uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', '') in ['person', 'company']
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType != 'company'
          || request.resource.data.keys().hasAll(['publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription']))
        && validOpportunity(request.resource.data);
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['published', 'closed']
        && active(request.resource.data.lastSelectedApplicantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCount', 'lastSelectedApplicantId'])
        && request.resource.data.selectedCount == resource.data.selectedCount + 1
        && request.resource.data.selectedCount <= resource.data.vacancies
        && request.resource.data.lastSelectedApplicantId is string
        && exists(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.resource.data.lastSelectedApplicantId))
        && get(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.resource.data.lastSelectedApplicantId)).data.status in ['pending', 'reviewing']
        && getAfter(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.resource.data.lastSelectedApplicantId)).data.status == 'selected';
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid && resource.data.status == 'published'
        && resource.data.selectedCount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'location', 'pay', 'duration', 'requirements', 'category', 'vacancies', 'updatedAt', 'noExperienceRequired', 'workMode', 'publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription'])
        && (!('noExperienceRequired' in request.resource.data) || request.resource.data.noExperienceRequired is bool)
        && (!('workMode' in request.resource.data) || request.resource.data.workMode in ['Presencial', 'Híbrido', 'Remoto'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription']) || validBusinessSnapshot(request.resource.data))
        && textWithin(request.resource.data.title, 3, 120)
        && textWithin(request.resource.data.description, 10, 3000)
        && textWithin(request.resource.data.location, 2, 120)
        && textWithin(request.resource.data.pay, 3, 120)
        && textWithin(request.resource.data.duration, 2, 120)
        && textWithin(request.resource.data.requirements, 2, 1500)
        && textWithin(request.resource.data.category, 2, 40)
        && request.resource.data.vacancies is int && request.resource.data.vacancies >= 1 && request.resource.data.vacancies <= 99
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusChangedAt'])
        && request.resource.data.statusChangedAt == request.time
        && ((resource.data.status == 'published' && request.resource.data.status == 'closed')
          || (resource.data.status == 'closed' && request.resource.data.status == 'published' && resource.data.selectedCount < resource.data.vacancies));
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid && resource.data.status in ['published', 'closed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCount', 'lastCancelledApplicantId'])
        && request.resource.data.lastCancelledApplicantId is string
        && active(request.resource.data.lastCancelledApplicantId)
        && resource.data.selectedCount > 0 && request.resource.data.selectedCount == resource.data.selectedCount - 1
        && get(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.resource.data.lastCancelledApplicantId)).data.status == 'selected'
        && getAfter(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.resource.data.lastCancelledApplicantId)).data.status == 'cancelled';
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription', 'updatedAt'])
        && !request.resource.data.keys().hasAny(['publicBusinessName', 'publicBusinessSector', 'publicBusinessDescription'])
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && active(request.auth.uid)
        && resource.data.ownerId == request.auth.uid && resource.data.status == 'published'
        && resource.data.selectedCount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'removedAt'])
        && request.resource.data.status == 'removed' && request.resource.data.removedAt == request.time;
      allow update: if signedIn() && active(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCount', 'lastWithdrawnApplicantId'])
        && request.resource.data.lastWithdrawnApplicantId == request.auth.uid
        && resource.data.selectedCount > 0 && request.resource.data.selectedCount == resource.data.selectedCount - 1
        && get(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.auth.uid)).data.status == 'selected'
        && getAfter(/databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(request.auth.uid)).data.status == 'withdrawn';
      allow delete: if false;

      match /applications/{applicantId} {
        function opportunity() {
          return get(opportunityPath(opportunityId));
        }

        match /privateFiles/{fileId} {
          function applicationPath() {
            return /databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(applicantId);
          }
          allow get: if fileId == 'cv' && signedIn() && active(request.auth.uid)
            && (request.auth.uid == applicantId || (opportunity().data.ownerId == request.auth.uid
              && exists(applicationPath())
              && get(applicationPath()).data.status in ['pending', 'reviewing', 'selected', 'rejected', 'completed']));
          allow list: if false;
          allow create, update: if fileId == 'cv' && signedIn() && active(request.auth.uid)
            && request.auth.uid == applicantId
            && getAfter(applicationPath()).data.status == 'pending'
            && request.resource.data.keys().hasOnly(['data', 'contentType', 'updatedAt'])
            && request.resource.data.keys().hasAll(['data', 'contentType', 'updatedAt'])
            && request.resource.data.data is bytes && request.resource.data.data.size() >= 5
            && request.resource.data.data.size() <= 700000
            && request.resource.data.contentType == 'application/pdf'
            && request.resource.data.updatedAt == request.time;
          allow delete: if fileId == 'cv' && signedIn() && active(request.auth.uid)
            && request.auth.uid == applicantId;
        }

        allow read: if signedIn()
          && (request.auth.uid == applicantId
            || (exists(opportunityPath(opportunityId))
              && opportunity().data.ownerId == request.auth.uid));
        allow create: if signedIn() && active(request.auth.uid)
          && request.auth.uid == applicantId
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', '') == 'person'
          && validIdentity(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '').matches('9[0-9]{8}')
          && textWithin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('skills', ''), 2, 500)
          && textWithin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('availability', ''), 2, 200)
          && exists(opportunityPath(opportunityId))
          && active(opportunity().data.ownerId)
          && opportunity().data.status == 'published'
          && opportunity().data.selectedCount < opportunity().data.vacancies
          && opportunity().data.ownerId != request.auth.uid
          && request.resource.data.keys().hasAll(['applicantId', 'applicantName', 'applicantSkills', 'applicantAvailability', 'applicantExperience', 'applicantDistrict', 'applicantEducation', 'applicantPortfolio', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['applicantId', 'applicantName', 'applicantSkills', 'applicantAvailability', 'applicantExperience', 'applicantDistrict', 'applicantEducation', 'applicantPortfolio', 'status', 'createdAt'])
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.applicantName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && textWithin(request.resource.data.applicantName, 2, 80)
          && request.resource.data.applicantSkills == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('skills', '')
          && request.resource.data.applicantAvailability == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('availability', '')
          && request.resource.data.applicantExperience == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('experience', '')
          && request.resource.data.applicantDistrict == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('district', '')
          && request.resource.data.applicantEducation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('education', '')
          && request.resource.data.applicantPortfolio == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('portfolio', '')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && active(request.auth.uid)
          && opportunity().data.ownerId == request.auth.uid
          && active(applicantId)
          && (
            (resource.data.status in ['pending', 'reviewing']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'selectedAt'])
              && request.resource.data.status == 'selected'
              && request.resource.data.selectedAt == request.time
              && getAfter(opportunityPath(opportunityId)).data.selectedCount == opportunity().data.selectedCount + 1
              && getAfter(opportunityPath(opportunityId)).data.lastSelectedApplicantId == applicantId)
            || (resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
              && request.resource.data.status == 'reviewing' && request.resource.data.reviewedAt == request.time)
            || (resource.data.status in ['pending', 'reviewing']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt'])
              && request.resource.data.status == 'rejected' && request.resource.data.decisionAt == request.time)
            || (resource.data.status == 'selected'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt'])
              && request.resource.data.status == 'cancelled' && request.resource.data.decisionAt == request.time
              && getAfter(opportunityPath(opportunityId)).data.selectedCount == opportunity().data.selectedCount - 1
              && getAfter(opportunityPath(opportunityId)).data.lastCancelledApplicantId == applicantId)
            || (resource.data.status == 'selected'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time)
          );
        allow update: if signedIn() && active(request.auth.uid) && request.auth.uid == applicantId
          && resource.data.status == 'completed'
          && !('workerConfirmedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerConfirmedAt'])
          && request.resource.data.workerConfirmedAt == request.time;
        allow update: if signedIn() && active(request.auth.uid) && request.auth.uid == applicantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt'])
          && request.resource.data.status == 'withdrawn' && request.resource.data.withdrawnAt == request.time
          && (resource.data.status in ['pending', 'reviewing'] || (resource.data.status == 'selected'
            && getAfter(opportunityPath(opportunityId)).data.selectedCount == opportunity().data.selectedCount - 1
            && getAfter(opportunityPath(opportunityId)).data.lastWithdrawnApplicantId == applicantId));
        allow update: if signedIn() && active(request.auth.uid) && request.auth.uid == applicantId
          && resource.data.status in ['withdrawn', 'cancelled'] && opportunity().data.status == 'published'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', '') == 'person'
          && active(opportunity().data.ownerId) && opportunity().data.selectedCount < opportunity().data.vacancies
          && validIdentity(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '').matches('9[0-9]{8}')
          && textWithin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('skills', ''), 2, 500)
          && textWithin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('availability', ''), 2, 200)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt', 'withdrawnAt', 'selectedAt', 'completedAt', 'reviewedAt', 'decisionAt', 'applicantName', 'applicantSkills', 'applicantAvailability', 'applicantExperience', 'applicantDistrict', 'applicantEducation', 'applicantPortfolio'])
          && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
          && !('withdrawnAt' in request.resource.data) && !('selectedAt' in request.resource.data) && !('completedAt' in request.resource.data) && !('reviewedAt' in request.resource.data) && !('decisionAt' in request.resource.data)
          && request.resource.data.applicantName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.applicantSkills == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('skills', '')
          && request.resource.data.applicantAvailability == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('availability', '')
          && request.resource.data.applicantExperience == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('experience', '')
          && request.resource.data.applicantDistrict == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('district', '')
          && request.resource.data.applicantEducation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('education', '')
          && request.resource.data.applicantPortfolio == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('portfolio', '');
        allow delete: if false;

        match /messages/{messageId} {
          function applicationPath() {
            return /databases/$(database)/documents/opportunities/$(opportunityId)/applications/$(applicantId);
          }

          function participant() {
            return signedIn() && exists(opportunityPath(opportunityId)) && exists(applicationPath())
              && (request.auth.uid == applicantId || opportunity().data.ownerId == request.auth.uid);
          }

          allow read: if participant();
          allow create: if participant() && active(request.auth.uid)
            && active(applicantId) && active(opportunity().data.ownerId)
            && opportunity().data.status in ['published', 'closed']
            && get(applicationPath()).data.status in ['pending', 'reviewing', 'selected', 'completed']
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
            && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
            && request.resource.data.senderId == request.auth.uid
            && textWithin(request.resource.data.text, 1, 2000)
            && request.resource.data.text.matches('(?s).*\\S.*')
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
    }

    match /{path=**}/applications/{applicantId} {
      allow list: if signedIn() && resource.data.applicantId == request.auth.uid;
    }

    match /workReferences/{referenceId} {
      function refOpportunity() {
        return /databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId);
      }
      function refApplication() {
        return /databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)/applications/$(request.resource.data.workerId);
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/workReferences/$(referenceId))
        || resource.data.visible == true || resource.data.workerId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow list: if signedIn() && resource.data.visible == true;
      allow create: if signedIn() && active(request.auth.uid)
        && request.resource.data.keys().hasOnly(['opportunityId', 'workerId', 'authorId', 'authorName', 'title', 'text', 'visible', 'createdAt'])
        && request.resource.data.keys().hasAll(['opportunityId', 'workerId', 'authorId', 'authorName', 'title', 'text', 'visible', 'createdAt'])
        && request.resource.data.opportunityId is string && request.resource.data.workerId is string
        && referenceId == request.resource.data.opportunityId + '_' + request.resource.data.workerId
        && request.resource.data.workerId != request.auth.uid && active(request.resource.data.workerId)
        && request.resource.data.authorId == request.auth.uid
        && exists(refOpportunity()) && get(refOpportunity()).data.ownerId == request.auth.uid
        && request.resource.data.authorName == get(refOpportunity()).data.ownerName
        && request.resource.data.title == get(refOpportunity()).data.title
        && exists(refApplication()) && get(refApplication()).data.status == 'completed'
        && get(refApplication()).data.workerConfirmedAt is timestamp
        && textWithin(request.resource.data.text, 10, 500)
        && request.resource.data.text.matches('(?s).*\\S.*')
        && request.resource.data.visible == false && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && active(request.auth.uid) && resource.data.workerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible'])
        && request.resource.data.visible is bool
        && (request.resource.data.visible == false
          || !exists(/databases/$(database)/documents/referenceDisputes/$(referenceId))
          || get(/databases/$(database)/documents/referenceDisputes/$(referenceId)).data.get('resolution', '') != 'hide');
      allow delete: if false;
    }

    match /referenceDisputes/{referenceId} {
      allow create: if signedIn() && active(request.auth.uid)
        && exists(/databases/$(database)/documents/workReferences/$(referenceId))
        && get(/databases/$(database)/documents/workReferences/$(referenceId)).data.workerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['referenceId', 'workerId', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['referenceId', 'workerId', 'details', 'status', 'createdAt'])
        && request.resource.data.referenceId == referenceId && request.resource.data.workerId == request.auth.uid
        && textWithin(request.resource.data.details, 10, 500) && request.resource.data.details.matches('(?s).*\\S.*')
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow get: if signedIn() && resource.data.workerId == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && active(request.auth.uid)
        && request.resource.data.keys().hasOnly(['reporterId', 'opportunityId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterId', 'opportunityId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.opportunityId is string
        && reportId == request.auth.uid + '_' + request.resource.data.opportunityId
        && exists(opportunityPath(request.resource.data.opportunityId))
        && active(get(opportunityPath(request.resource.data.opportunityId)).data.ownerId)
        && request.resource.data.reason in ['Información engañosa', 'Pago o condiciones', 'Seguridad', 'Otro']
        && textWithin(request.resource.data.details, 10, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
