rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function textWithin(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'email'])
        && data.keys().hasOnly(['uid', 'displayName', 'email'])
        && data.uid == uid
        && textWithin(data.displayName, 2, 80)
        && data.displayName.matches('(?s).*\\S.*')
        && textWithin(data.email, 3, 254);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }

    function opportunityPath(opportunityId) {
      return /databases/$(database)/documents/opportunities/$(opportunityId);
    }

    function validOpportunity(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'description', 'location', 'pay', 'duration',
          'vacancies', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'description', 'location', 'pay', 'duration',
          'vacancies', 'status', 'createdAt'
        ])
        && data.ownerId == request.auth.uid
        && textWithin(data.title, 3, 120)
        && textWithin(data.description, 10, 3000)
        && textWithin(data.location, 2, 120)
        && textWithin(data.pay, 3, 120)
        && textWithin(data.duration, 2, 120)
        && data.vacancies is int && data.vacancies >= 1 && data.vacancies <= 1000
        && data.status == 'published'
        && data.createdAt == request.time;
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && validOpportunity(request.resource.data);
      allow update, delete: if false;

      match /applications/{applicantId} {
        function opportunity() {
          return get(opportunityPath(opportunityId));
        }

        allow read: if signedIn()
          && (request.auth.uid == applicantId
            || (exists(opportunityPath(opportunityId))
              && opportunity().data.ownerId == request.auth.uid));
        allow create: if signedIn()
          && request.auth.uid == applicantId
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && exists(opportunityPath(opportunityId))
          && opportunity().data.status == 'published'
          && opportunity().data.ownerId != request.auth.uid
          && request.resource.data.keys().hasAll(['applicantId', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['applicantId', 'status', 'createdAt'])
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
